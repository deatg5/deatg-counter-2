{
    "name": "deatg-counter",
    "version": "1.0.0",
    "description": "Counter of deatg",
    "main": "dist/electron/main.js",
    "scripts": {
        "start": "tsc && electron .",
        "build": "tsc && electron-builder build",
        "dev": "tsc -w"
    },
    "dependencies": {
        "discord-rpc": "^4.0.1",
        "electron-updater": "^6.1.7",
        "uiohook-napi": "^1.5.4"
    },
    "devDependencies": {
        "@types/discord-rpc": "^4.0.10",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "typescript": "^5.0.0"
    },
    "build": {
        "appId": "com.yourname.shinycounter",
        "files": [
            "dist/**/*",
            "public/**/*"
        ],
        "directories": {
            "output": "release"
        },
        "win": {
            "target": "nsis"
        },
        "mac": {
            "target": "dmg"
        },
        "linux": {
            "target": "AppImage"
        }
    }
}
