{
    "name": "deatg-counter",
    "version": "1.0.0",
    "description": "Counter of deatg",
    "main": "dist/electron/main.js",
    "scripts": {
        "start": "tsc && electron .",
        "build": "tsc && electron-builder build",
        "dev": "tsc -w",
        "pack": "electron-builder --dir",
        "dist": "npm run build && electron-builder"
    },
    "dependencies": {
        "discord-rpc": "^4.0.1",
        "electron-updater": "^6.1.7",
        "uiohook-napi": "^1.5.4"
    },
    "devDependencies": {
        "@types/discord-rpc": "^4.0.10",
        "electron": "^28.0.0",
        "electron-builder": "^24.13.3",
        "typescript": "^5.0.0"
    },
    "build": {
    "appId": "com.deatg.counter",
    "productName": "deatg counter 2",
    "directories": {
      "output": "release/"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "package.json"
    ]
  }
}
